GITLAB_BASE_URL=https://gitlab.com
# HTML comment prefix written into Issue bodies to find them again. Keep your old value once Issues exist.
INTEGRATION_MARKER_PREFIX=intake
# Marketing posts and watch sources are Beta; false hides their menu entries and pages.
BETA_FEATURES_ENABLED=false
GITLAB_INTEGRATION_ENABLED=false
# Personal access token with scopes api and read_repository, role Reporter or higher on each project.
# Optional: the CTO can save it on screen instead (Projects > GitLab connection), which wins over this value (ADR-0080).
GITLAB_TOKEN=
# Optional separate read-only token for the repo-reader (ADR-0063). Empty: GITLAB_TOKEN reads the project context file.
GITLAB_REPO_READ_TOKEN=
SYNC_JOB_MAX_ATTEMPTS=5
SYNC_JOB_LEASE_SECONDS=120
APP_ENV=development
APP_NAME=Private Feedback Intake
PROJECT_NAME=
POSTGRES_DB=intake
POSTGRES_USER=intake
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://intake:change-me@postgres:5432/intake
REDIS_URL=redis://:change-me@redis:6379/0
CELERY_BROKER_URL=redis://:change-me@redis:6379/1
REDIS_REQUIRED=true
OUTBOX_POLL_SECONDS=1
OUTBOX_BATCH_SIZE=20
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8
PIPELINE_RUN_LEASE_SECONDS=600
SECRET_KEY=change-me-in-production
# Web session length for every user, in minutes (default 7 days; FR-ID-09)
ACCESS_TOKEN_TTL_MINUTES=10080
COOKIE_SECURE=false
ALLOW_SUBJECT_HEADER_AUTH=false
CTO_INITIAL_PASSWORD=change-me-cto-password
PROJECT_OWNER_INITIAL_PASSWORD=change-me-owner-password
# First-run wizard (ADR-0071). Only install.sh / install.ps1 turn this on: the first visitor of /welcome then creates
# the CTO and Project Owner with their own email and password, and the setup page requires an AI key. Leave false
# on a running system; once the accounts exist the page closes for good.
FIRST_RUN_WIZARD=false
AI_PROVIDER_PRIMARY=umodelverse
AI_PROVIDER_FALLBACK=openrouter
AI_REQUEST_TIMEOUT_SECONDS=45
AI_REPORT_TIMEOUT_SECONDS=120
REPORT_AI_BATCH_SIZE=5
REPORT_LATE_CUTOFF=23:30
# AI keys and models are normally set on the AI tab in Settings (ADR-0070). The variables below are only
# the default when nothing is set there.
UMODELVERSE_API_KEY=
UMODELVERSE_BASE_URL=https://api-sg.umodelverse.ai/v1
UMODELVERSE_MODEL=deepseek-v4.1-flash
UMODELVERSE_PRO_MODEL=deepseek-v4-pro-0813
UMODELVERSE_VISION_MODEL=deepseek-v4-flash-vision-exp
# Reading pictures and PDFs attached to a request with the vision model (ADR-0061)
ATTACHMENT_VISION_ENABLED=true
ATTACHMENT_PDF_MAX_PAGES=8
AI_VISION_TIMEOUT_SECONDS=90
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
AI_TASK_MAX_RETRIES=3
SEAWEEDFS_S3_ACCESS_KEY=intake-local-access
SEAWEEDFS_S3_SECRET_KEY=change-me-seaweedfs-secret
S3_ENDPOINT_URL=http://seaweed-s3:8333
S3_BUCKET=intake-attachments
S3_REGION=us-east-1
STORAGE_BACKEND=seaweedfs
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8001
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Meeting capture (ADR-0018). Only the meeting-gateway container receives ELEVENLABS_API_KEY.
MEETING_CAPTURE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_REALTIME_MODEL=scribe_v2_realtime
ELEVENLABS_BATCH_MODEL=scribe_v2
ELEVENLABS_DELETE_AFTER_MEETING=true
MEETING_LANGUAGE=vi
MEETING_MAX_MINUTES=60
MEETING_MAX_SPEAKERS=8
MEETING_MAX_AUDIO_MB=200
MEETING_GATEWAY_PORT=8002
# Posting flow outside Intake (ADR-0038). Leave blank to keep both routes closed.
# Each is a random string of at least 24 characters, set on the server only, never sent in chat or email.
# PUBLISH_API_KEY lets the flow read approved posts; PUBLISH_WEBHOOK_SECRET signs its calls back.
PUBLISH_API_KEY=
PUBLISH_WEBHOOK_SECRET=
# Scanning flow outside Intake (ADR-0039). Same rules: blank keeps both routes closed, 24 characters or more, server only.
# WATCH_API_KEY lets the flow read sources and keywords; WATCH_WEBHOOK_SECRET signs the signals it sends back.
WATCH_API_KEY=
WATCH_WEBHOOK_SECRET=
# The short domain of posts' links (FR-MKT-12), e.g. https://go.example.com; its /p/ must reach this API. Empty shows relative links.
SHORT_LINK_BASE=
REPORT_IMAP_ENABLED=false
REPORT_IMAP_HOST=imap.example.com
REPORT_IMAP_PORT=993
REPORT_IMAP_USERNAME=report@example.com
REPORT_IMAP_PASSWORD=
REPORT_IMAP_FOLDER=INBOX
REPORT_IMAP_POLL_SECONDS=1800
REPORT_IMAP_FETCH_LIMIT=200
# Contact/lead mailbox (ADR-0017, phase 2). Reserved: not read by the code yet.
CONTACT_IMAP_ENABLED=false
CONTACT_IMAP_HOST=imap.example.com
CONTACT_IMAP_PORT=993
CONTACT_IMAP_USERNAME=contact@example.com
CONTACT_IMAP_PASSWORD=
CONTACT_IMAP_FOLDER=INBOX
CONTACT_SCAN_WORK_HOURS=08:00-18:00
CONTACT_SCAN_WORK_MINUTES=15
CONTACT_SCAN_OFF_MINUTES=120
CONTACT_IMAP_FETCH_LIMIT=200
CONTACT_FORM_SENDER=
CONTACT_MAX_MESSAGE_BYTES=262144
CONTACT_AI_DAILY_LIMIT=200
RAW_RETENTION_DAYS=90
# Daily encrypted backup (ADR-0025). BACKUP_DIR is a folder on this machine; point it at the folder you sync
# to a cloud drive. BACKUP_PASSPHRASE (16 characters or more) encrypts every backup: keep a copy of it, and of
# this .env file, somewhere other than that folder. Without the passphrase a backup cannot be restored.
BACKUP_DIR=./data/backups
BACKUP_PASSPHRASE=
BACKUP_TIME=01:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# Server reached from the internet (ADR-0027). Leave these out on a workstation.
# COMPOSE_FILE makes every `docker compose` command include the Caddy service.
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
# INTAKE_DOMAIN=intake.example.com
# ACME_EMAIL=

# Reminders over Telegram (ADR-0057). Create the bot with @BotFather; the token stays here on the server and only
# the telegram-bot container reads it. The username (without @) builds the invite links people open.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public URL used in reminder and one-time password-reset links. No trailing slash.
APP_PUBLIC_URL=https://intake.example.com

# Password recovery over Mailgun HTTPS API (the application does not use Mailgun SMTP).
# Production: verify a dedicated sending domain such as mg.example.com, then create a
# Domain Sending Key in Mailgun. Keep the real key only in the deployed .env/secret store.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM="Private Intake <no-reply@mg.example.com>"
# US domain: https://api.mailgun.net ; EU domain: https://api.eu.mailgun.net
MAILGUN_API_BASE_URL=https://api.mailgun.net
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RESEND_SECONDS=60
